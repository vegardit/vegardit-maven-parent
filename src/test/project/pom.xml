<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.vegardit.maven</groupId>
    <artifactId>vegardit-maven-parent</artifactId>
    <version>8.2.4-SNAPSHOT</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>

  <artifactId>vegardit-maven-parent.test</artifactId>
  <description>Verifies the parent POM's toolchains and inherited artifact signing.</description>

  <properties>
    <jdk.version.unit-tests>21</jdk.version.unit-tests>
    <!-- Use a different JDK to verify the switch from unit tests to integration tests. -->
    <jdk.version.integration-tests>17</jdk.version.integration-tests>
    <maven.surefire.args>-Djdk.version.unit-tests=${jdk.version.unit-tests}</maven.surefire.args>
    <maven.failsafe.args>-Djdk.version.integration-tests=${jdk.version.integration-tests}</maven.failsafe.args>
    <failIfNoITests>true</failIfNoITests>
    <maven.deploy.skip>true</maven.deploy.skip>
    <central-publishing-maven-plugin.excludedArtifacts>${project.artifactId}</central-publishing-maven-plugin.excludedArtifacts>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>6.1.3</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.gmavenplus</groupId>
        <artifactId>gmavenplus-plugin</artifactId>
        <executions>
          <execution>
            <id>check-signing@verify</id>
            <phase>verify</phase>
            <goals>
              <goal>execute</goal>
            </goals>
            <configuration>
              <scripts>
                <script>${project.basedir}/src/test/groovy/verify-signing.groovy</script>
              </scripts>
            </configuration>
          </execution>
        </executions>
        <dependencies>
          <dependency>
            <!-- Generate disposable keys and verify signatures without a GPG executable. -->
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpg-jdk18on</artifactId>
            <version>1.85</version>
          </dependency>
        </dependencies>
      </plugin>
      <plugin>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>check-integration-tests@verify</id>
            <phase>verify</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <!-- A missing Failsafe binding must fail a clean build even though no integration test can run. -->
                <fail message="Failsafe did not run RuntimeJavaVersionITest. Check that the parent activates maven-failsafe-plugin.">
                  <condition>
                    <and>
                      <not><istrue value="${skipTests}" /></not>
                      <not><istrue value="${skipITs}" /></not>
                      <not><istrue value="${maven.test.skip}" /></not>
                      <not>
                        <available file="${project.build.directory}/failsafe-reports/TEST-com.vegardit.maven.parent.test.RuntimeJavaVersionITest.xml" type="file" />
                      </not>
                    </and>
                  </condition>
                </fail>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
